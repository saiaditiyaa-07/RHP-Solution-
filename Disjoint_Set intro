#include<iostream>
#include<vector>
#include<set>
using namespace std;
int find(vector<int> &arr,int node){
	if(arr[node]!=node){
		arr[node]=find(arr,arr[node]);
	}
	return arr[node];
	
}
void join(vector<int> &arr,int lt,int rt){
	int findlt=find(arr,lt);
	int findrt=find(arr,rt);
	arr[findrt]=findlt;
	
}
int main(){
	int N;
	cin>>N;
	int M;
	cin>>M;
	vector<int> arr(N+1);
	for(int i=1;i<N+1;i++){
		arr[i]=i;
	}
	
	for(int i=0;i<=M;i++){
		int l,r;
		cin>>l>>r;
		join(arr,l,r);
	}
	set<int> st;
	for(int i=1;i<N+1;i++){
		st.insert(find(arr,i));
	}
	cout<<st.size();
	
}
